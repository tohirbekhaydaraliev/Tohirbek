# --- Server ---
PORT=8787
# Ommaviy URL (webhooklar va Telegram uchun), masalan https://yoldosh.example.uz
PUBLIC_URL=http://localhost:8787
# API himoyasi: o'rnatilsa, barcha /api so'rovlari "Authorization: Bearer <token>" talab qiladi
YOLDOSH_API_TOKEN=
# Connector maxfiy kalitlarini (tokenlar) bazada shifrlash uchun kalit (istalgan uzun tasodifiy satr)
YOLDOSH_SECRET_KEY=

# --- Ma'lumotlar bazasi ---
# Bo'sh qoldirilsa, ichki PostgreSQL (PGlite) ./data/pg papkasida ishlaydi.
# Production uchun: postgres://user:pass@host:5432/yoldosh
DATABASE_URL=
YOLDOSH_DATA_DIR=./data/pg
# Birinchi ishga tushishda demo biznes ("Edinburg" o'quv markazi) ma'lumotlarini yaratish
YOLDOSH_SEED_DEMO=true

# --- AI (Claude) ---
ANTHROPIC_API_KEY=
# Model (standart: claude-opus-5-5)
YOLDOSH_MODEL=claude-opus-5-5

# --- Biznes ---
YOLDOSH_TZ=Asia/Tashkent
# Rejalashtiruvchi (kunlik diagnostika 08:00, sinxronlash, qoidalar)
YOLDOSH_SCHEDULER=true
