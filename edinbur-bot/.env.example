# Bu faylni .env nomi bilan nusxalang va qiymatlarni yozing. .env gitga tushmaydi.

# @BotFather bergan token
TELEGRAM_BOT_TOKEN=
# Call-center guruhi ID si (botni guruhga qo'shib, guruhda /chatid yozing). Odatda -100 bilan boshlanadi
GROUP_CHAT_ID=
# https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# --- Ixtiyoriy sozlamalar (yozilmasa shu qiymatlar ishlatiladi) ---
# ANTHROPIC_MODEL=claude-haiku-5-5
# Qancha "o'ylashi": low | medium | high (yuqori = aniqroq, lekin sekinroq va qimmatroq)
# ANTHROPIC_EFFORT=medium
# DATABASE_PATH=data/bot.db
# LOG_FILE=data/bot.log
# KNOWLEDGE_PATH=knowledge.md
# TIMEZONE=Asia/Tashkent
# Operator chaqirilgandan keyin necha soat AI jim turadi (mijoz /start yozsa darhol qaytadi)
# HANDOFF_HOURS=24
# 1 bo'lsa arizalar guruhga emas, faqat logga yoziladi (sinov uchun)
# DRY_RUN=0
